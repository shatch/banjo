# --- Server ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
PUBLIC_HOSTNAME=your-alb-or-ngrok-hostname.example.com

# --- Assistant identity ---
# The person this assistant acts on behalf of — used in every call's system
# prompt (e.g. "calling on behalf of Alex"). Required, no default.
ASSISTANT_PRINCIPAL_NAME=
# What Banjo says first on every outbound call. {name} becomes ASSISTANT_PRINCIPAL_NAME. The wording
# is yours, but it must say "AI" (startup fails otherwise).
# DISCLOSURE_LINE=Hi, I'm an AI assistant calling on behalf of {name}.

# --- Database ---
DATABASE_URL=postgresql://banjo:banjo@localhost:5432/banjo

# Apply the committed drizzle/ migrations at startup. On by default — leave it
# alone unless something else owns your schema. Note: docker compose overrides
# DATABASE_URL to point at the `postgres` service, so the value above is only
# used by `npm run dev` / `npm test` / drizzle-kit on the host.
RUN_MIGRATIONS_ON_BOOT=true

# --- Voice AI provider (vendor-agnostic layer) ---
VOICE_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
# Input noise reduction (VOICE_AI_PROVIDER=openai): far_field (speakerphones,
# the default), near_field (handsets) or off. Keeps noise and echo from
# cutting Banjo off.
OPENAI_NOISE_REDUCTION=far_field
# Used only when VOICE_AI_PROVIDER=openai-live (GPT-Live — ships dark: tested
# on live calls, but not the default). Reuses OPENAI_API_KEY. The backend model
# default is unconfirmed; see docs/ARCHITECTURE.md's Open Risks.
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_BACKEND_MODEL=gpt-5.6-terra
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# --- Telephony (outbound origination via Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Require a valid X-Twilio-Signature on all inbound Twilio webhooks (default
# on). Set to false only for local curl-based testing of the webhook routes
# directly — real Twilio traffic always carries a valid signature, so this
# should stay true anywhere it might reach a real deployment.
TWILIO_WEBHOOK_VALIDATION_ENABLED=true

# --- Calendar and contacts ---
# Where your personal calendar lives: google (OAuth, below) or caldav (Fastmail, iCloud, Nextcloud, ...).
CALENDAR_PROVIDER=google
# Where your contacts live, for caller ID and find_contact: google (OAuth, below), carddav, or none.
CONTACTS_PROVIDER=google

# --- CalDAV / CardDAV (when CALENDAR_PROVIDER=caldav or CONTACTS_PROVIDER=carddav) ---
# One sign-in for both. Use an app password, never your account password (Fastmail: Settings →
# Privacy & Security; see docs/RUNBOOKS.md's "Connecting Fastmail calendar and contacts").
# `npm run dav:check` lists your calendars and address books with their URLs.
# DAV_USERNAME=you@fastmail.com
# DAV_PASSWORD=
# Optional: your addresses, comma-separated, so invitations you declined don't block time.
# By default Banjo reads them from the server; set this if one you're invited at is missing.
# DAV_OWNER_EMAIL=you@example.com,you@fastmail.com
# CALDAV_CALENDAR_URL=https://caldav.fastmail.com/dav/calendars/user/you@fastmail.com/<calendar-id>/
# CARDDAV_ADDRESSBOOK_URL=https://carddav.fastmail.com/dav/addressbooks/user/you@fastmail.com/Default/

# --- Google Calendar (when CALENDAR_PROVIDER=google; your own calendar, OAuth2 user-consent flow) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# IANA zone — what "2pm" means on a call and how times are written to the calendar.
CALENDAR_TIMEZONE=America/New_York

# --- Owner profile (optional) ---
# Your standing notes for every outbound call: facts about you and yours, and how calls should sound.
# See banjo-profile.example.md. Relative paths resolve from the project root (and /app in Docker —
# see the commented volume in docker-compose.yml). Checked at boot; re-read on every call.
# PROMPT_PROFILE_FILE=./banjo-profile.md

# --- Notifications ---
# How Banjo tells you a call's outcome: twilio_sms, pushover, or none.
NOTIFICATION_CHANNEL=twilio_sms
# twilio_sms: US numbers need A2P 10DLC registration, or texts are silently blocked (see README).
NOTIFY_TO_PHONE_NUMBER=
NOTIFY_FROM_PHONE_NUMBER=
# pushover (https://pushover.net): create an application for its API token; your user key is on
# the dashboard. Calls that need your attention are sent at high priority, past quiet hours.
# PUSHOVER_APP_TOKEN=
# PUSHOVER_USER_KEY=
# PUSHOVER_DEVICE=        # optional: deliver to one device only

# --- Task webhook (optional) ---
# POSTed a signed JSON event whenever a call finishes, so the agent that placed it hears back
# instead of polling. Signed like Hermes Agent's generic webhooks (X-Webhook-Signature-V2).
# TASK_WEBHOOK_TOKEN is also sent as a bearer token, for receivers such as OpenClaw's hooks.
# TASK_WEBHOOK_URL=
# TASK_WEBHOOK_SECRET=     # at least 32 characters: openssl rand -hex 32
# TASK_WEBHOOK_TOKEN=
# Who tells you a call's outcome: notification (NOTIFICATION_CHANNEL, the default) or webhook (the
# agent behind TASK_WEBHOOK_URL, e.g. Hermes over iMessage). With webhook, the end-of-call summary
# goes to NOTIFICATION_CHANNEL only if the webhook isn't delivered, so you aren't told twice. Hold,
# inbound-booking and flagged-call alerts still use NOTIFICATION_CHANNEL.
# OUTCOME_SUMMARY_VIA=notification

# --- MCP server (remote, HTTP/SSE) ---
MCP_API_KEY=
# Optional: a second key for always-on agents (Hermes, OpenClaw). Calls placed
# with it wait for you to tap Approve on a link Banjo sends you; needs
# PUBLIC_HOSTNAME and a NOTIFICATION_CHANNEL the agent can't read (Pushover, if
# the agent can see your texts). Generate: openssl rand -hex 32
MCP_AGENT_API_KEY=

# --- Tool execution ---
TOOL_TIMEOUT_MS=8000

# --- Debugging ---
# Off by default: call transcripts can contain PII (medical/appointment
# details, identity-verification info). Set to true only for local-dev
# debugging of call behavior.
LOG_TRANSCRIPTS=false

# --- Saved transcripts (optional) ---
# Save every line of every call to Postgres, readable with the get_call_transcript MCP tool.
# Off by default: it stores what people said to you, which may include personal details.
PERSIST_TRANSCRIPTS=false
# Saved transcripts older than this many days are deleted (at startup, then daily). 0 keeps them
# forever. Applies even with saving off, so turning it off doesn't keep old transcripts forever.
TRANSCRIPT_RETENTION_DAYS=30

# --- Call recording (optional) ---
# Record outbound calls, two-track, in your Twilio account. Off by default. When on, Banjo's opening
# line gains "This call is recorded." (unless DISCLOSURE_LINE already mentions recording), and recording
# starts only after Banjo has said it. Listen in the Twilio console.
RECORD_CALLS=false
# Recordings older than this many days are deleted from Twilio (at startup, then daily). 0 keeps them
# forever. Applies even with recording off.
RECORDING_RETENTION_DAYS=30

# --- Call cap ---
# Banjo places at most this many outbound calls to one phone number in any rolling 24 hours.
# place_call refuses past it, and a scheduled call that would exceed it fails instead of dialing.
MAX_CALLS_PER_NUMBER_PER_DAY=3
# Big companies' support lines (an IVR and a call centre, not someone's own
# phone) that need more tries to get through a long phone menu. Comma-separated
# E.164; each gets CALL_CAP_BUSINESS_MAX calls a day (default 10, at most 20)
# instead. Only set here: nothing a call or an MCP client sends can add one.
# CALL_CAP_BUSINESS_NUMBERS=+18005550100,+18885550101
# CALL_CAP_BUSINESS_MAX=10

# --- Call transfer (optional) ---
# Lets Banjo hand a live call to you when the other party needs you personally and agrees to be
# connected. Off by default. Cold transfer: Banjo drops off once your phone starts ringing.
# On the inbound line, only callers found in your contacts can be transferred; others are flagged.
TRANSFER_ENABLED=false
# Your phone, E.164. Required when TRANSFER_ENABLED=true. (Left commented: an empty value fails E.164 validation.)
# TRANSFER_TO_PHONE_NUMBER=+15551234567
# cold (default): the call is redirected to ring you, and Banjo leaves it.
# warm: Banjo calls you on a second line and reads you a brief while the other party holds. Press 1 to be
# connected; otherwise Banjo goes back to them and carries on. Not yet verified on a live call.
TRANSFER_MODE=cold

# Waiting on hold (#151): the longest an outbound call waits in a queue for a person, 1–45 minutes. Banjo stays
# silent while it waits, and you're notified when the hold starts and when someone picks up.
HOLD_MAX_MINUTES=20
# What the other party hears if you don't pick up, before the call ends.
# TRANSFER_FALLBACK_MESSAGE=Sorry, they couldn't be reached right now. They'll get back to you soon. Goodbye.
# Transcribe what you and the other party say after a cold transfer, into the call's transcript.
# Off by default. Needs PERSIST_TRANSCRIPTS=true and OPENAI_API_KEY. They hear "This call will be
# recorded." before your phone rings, and your press-1 screen says so too. Twilio records the two
# sides apart; once the call ends the recording is transcribed, then deleted: only the text is kept.
TRANSCRIBE_TRANSFERS=false

# --- Questions to you mid-call (optional) ---
# When the other party asks something the task doesn't cover, Banjo tells them it'll check, and sends
# you the question through NOTIFICATION_CHANNEL with a link to a page where you type the answer; Banjo
# then gives it to them. Needs a NOTIFICATION_CHANNEL other than none, and PUBLIC_HOSTNAME. OpenAI
# Realtime only. Off by default.
ASK_OWNER_ENABLED=false
# How long Banjo waits for your answer (30–600 seconds) before carrying on without it.
ASK_OWNER_TIMEOUT_SECONDS=120

# --- Call screening (optional) ---
# Checks each call request before it's placed, and a scheduled call again when it comes due. A request
# to someone who asked on an earlier call not to be called again, one the model flags (fraud,
# harassment, collecting someone's card number, password or one-time code, pretending to be you,
# unclear instructions), or one the check couldn't run on, waits for your approval: you get the reason
# and a link, as for an agent's request. Needs OPENAI_API_KEY, a NOTIFICATION_CHANNEL other than none,
# and PUBLIC_HOSTNAME. Off by default.
SCREEN_CALLS=false
# SCREEN_CALLS_MODEL=gpt-5.6-terra

# --- Inbound voice booking line ---
# Kill switch — the public phone line only goes live once every downstream
# piece (Twilio routing, tools, abuse-mitigation posture) is actually ready.
INBOUND_BOOKING_ENABLED=false
# Comma-separated day-of-week numbers a caller can book into, 0 (Sun) - 6 (Sat).
BUSINESS_HOURS_DAYS=1,2,3,4,5
# Business-hours start, 0-23 (inclusive), in CALENDAR_TIMEZONE.
BUSINESS_HOURS_START=9
# Business-hours end, 1-24 (exclusive-of-start/inclusive-of-end), in CALENDAR_TIMEZONE.
BUSINESS_HOURS_END=17
# Default appointment length when the caller doesn't specify one.
INBOUND_DEFAULT_DURATION_MINUTES=30
# How many days out a caller may book an appointment.
INBOUND_MAX_LOOKAHEAD_DAYS=14

# --- Google Contacts integration ---
# ISO 3166-1 alpha-2 region for interpreting phone numbers with no explicit
# country code when normalizing Google Contacts data.
DEFAULT_PHONE_REGION=US
# Hours between contacts cache refreshes (Google: a full re-read; CardDAV: only what changed).
# The older name GOOGLE_CONTACTS_SYNC_INTERVAL_HOURS still works.
CONTACTS_SYNC_INTERVAL_HOURS=6
# Interaction count above which an inbound caller with no family/friend tier
# still gets a "welcome back" greeting.
FREQUENT_CONTACT_THRESHOLD=3

# Docker: which published image docker compose runs (ghcr.io/shatch/banjo). Defaults to latest.
# BANJO_VERSION=0.1.0
