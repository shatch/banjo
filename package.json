{
  "name": "banjo",
  "version": "0.1.16",
  "description": "Banjo — an open-source, self-hostable AI executive assistant that places real phone calls on your behalf",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "predb:generate": "npm run build",
    "db:generate": "drizzle-kit generate",
    "predb:migrate": "npm run build",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test:call": "tsx scripts/manual-test-call.ts",
    "sim": "tsx scripts/sim.ts",
    "eval": "tsx scripts/eval.ts",
    "fixtures:deploy": "tsx scripts/fixtures/deploy.ts",
    "fixtures:call": "tsx scripts/fixtures/run.ts",
    "dav:check": "tsx scripts/dav-check.ts",
    "setup": "tsx scripts/setup.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "googleapis": "^178.0.0",
    "hono": "^4.13.13",
    "libphonenumber-js": "^1.13.15",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "postgres": "^3.4.5",
    "twilio": "^5.4.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "yaml": "^2.9.1"
  }
}
