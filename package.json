{
  "name": "banjo",
  "version": "0.1.0",
  "description": "Banjo — an open-source, self-hostable AI executive assistant that places real phone calls on your behalf",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "predb:generate": "npm run build",
    "db:generate": "drizzle-kit generate",
    "predb:migrate": "npm run build",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test:call": "tsx scripts/manual-test-call.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@modelcontextprotocol/sdk": "^1.9.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "googleapis": "^144.0.0",
    "hono": "^4.6.13",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5",
    "twilio": "^5.4.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
