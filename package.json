{
  "name": "banjo",
  "version": "0.1.6",
  "description": "Banjo — an open-source, self-hostable AI executive assistant that places real phone calls on your behalf",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "predb:generate": "npm run build",
    "db:generate": "drizzle-kit generate",
    "predb:migrate": "npm run build",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test:call": "tsx scripts/manual-test-call.ts",
    "dav:check": "tsx scripts/dav-check.ts",
    "setup": "tsx scripts/setup.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "dotenv": "^18.0.6",
    "drizzle-orm": "^0.45.3",
    "fast-xml-parser": "^5.11.1",
    "googleapis": "^178.0.0",
    "hono": "^4.13.9",
    "libphonenumber-js": "^1.13.14",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5",
    "twilio": "^5.4.0",
    "ws": "^8.22.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
